# Copy to .env for LOCAL development (scripts/dev loads it automatically).
# On cPanel set these in "Setup Python App" environment instead — do NOT upload .env.

ENV=dev                       # "prod" => MySQL everywhere, anything else => SQLite
DJANGO_SECRET_KEY=change-me   # python3 -c "import secrets;print(secrets.token_hex(32))"
# DJANGO_DEBUG=1              # dev only: enable Django DEBUG + error pages
# DJANGO_ALLOWED_HOSTS=chat.example.com,www.chat.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://chat.example.com

# Only needed when ENV=prod (shared by Django sessions AND the core state store):
DB_HOST=localhost
DB_NAME=cpanel_user_chatstate
DB_USER=cpanel_chatuser
DB_PASSWORD=strong-password

# Web Push (python scripts/gen_vapid.py):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Optional tuning:
# PRESENCE_TTL=75  NUDGE_TTL=90  RL_MSG_MAX=30  RL_NUDGE_MAX=5
