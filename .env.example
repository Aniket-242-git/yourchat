# Copy to .env for LOCAL development (run.py loads it automatically).
# On cPanel set these in "Setup Python App" instead — do NOT upload .env.

ENV=dev                      # "prod" => MySQL, anything else => SQLite
SECRET_KEY=change-me         # python3 -c "import secrets;print(secrets.token_hex(32))"

# Only needed when ENV=prod:
DB_HOST=localhost
DB_NAME=cpanel_user_chatstate
DB_USER=cpanel_chatuser
DB_PASSWORD=strong-password

# Web Push (python scripts/gen_vapid.py):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:you@example.com

# Optional tuning:
# PRESENCE_TTL=75  NUDGE_TTL=90  RL_MSG_MAX=30  RL_NUDGE_MAX=5
